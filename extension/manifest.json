{
  "manifest_version": 3,
  "name": "PassVault",
  "version": "1.1.0",
  "description": "Tự điền tài khoản và mật khẩu từ app PassVault trên máy.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["fill.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PassVault (Ctrl+Shift+L)",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Mở PassVault để tự điền"
    }
  }
}
